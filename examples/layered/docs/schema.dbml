Table cartTable {
  customerId varchar [pk, note: 'The cart\'s id is its customer\'s: no foreign key, joined in the application']
  sequenceNumber integer
  createdAt timestamp [note: 'When the row was inserted']
  updatedAt timestamp [note: 'When the row was last changed']
  Note: 'A customer\'s cart, one per customer'
}

Table cartItemTable {
  customerId varchar
  productId varchar [note: 'No foreign key: the product may be gone while the cart still holds it']
  quantity integer
  createdAt timestamp [note: 'When the row was inserted']
  updatedAt timestamp [note: 'When the row was last changed']
  Note: 'A line of a cart'
}

Table customerTable {
  customerId varchar [pk]
  name varchar
  email varchar
  createdAt timestamp [note: 'When the row was inserted']
  updatedAt timestamp [note: 'When the row was last changed']
  Note: 'Someone who shops'
}

Table domainEventTable {
  eventId varchar [pk]
  occurredAt timestamp
  sequenceNumber integer
  eventName varchar
  aggregateId varchar
  aggregateName varchar
  payload jsonb
  Note: 'Every event an aggregate raised, in order'
}

Table orderTable {
  orderId varchar [pk]
  customerId varchar
  sequenceNumber integer
  createdAt timestamp [note: 'When the row was inserted']
  updatedAt timestamp [note: 'When the row was last changed']
  Note: 'An order placed from a cart'
}

Table orderItemTable {
  orderId varchar
  productId varchar
  price integer
  quantity integer
  createdAt timestamp [note: 'When the row was inserted']
  updatedAt timestamp [note: 'When the row was last changed']
  Note: 'A line of an order, priced when it was placed'
}

Table productTable {
  productId varchar [pk]
  name varchar
  price integer
  createdAt timestamp [note: 'When the row was inserted']
  updatedAt timestamp [note: 'When the row was last changed']
  Note: 'What is for sale'
}

Ref cartItemTable_customerId_cartTable_customerId_fk: cartItemTable.customerId > cartTable.customerId

Ref orderItemTable_orderId_orderTable_orderId_fk: orderItemTable.orderId > orderTable.orderId

Ref cartTable_customerId_customerTable_customerId: cartTable.customerId - customerTable.customerId

Ref cartItemTable_productId_productTable_productId: cartItemTable.productId > productTable.productId

Ref orderTable_customerId_customerTable_customerId: orderTable.customerId > customerTable.customerId

Ref orderItemTable_productId_productTable_productId: orderItemTable.productId > productTable.productId