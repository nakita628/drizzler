Table user {
  id text [pk]
  name text
  email text
  emailVerified boolean
  image text
  createdAt timestamp
  updatedAt timestamp
  role text
  banned boolean
  banReason text
  banExpires timestamp
  isAnonymous boolean
  lastLoginMethod text
  phoneNumber text
  phoneNumberVerified boolean
  twoFactorEnabled boolean
  username text
  displayUsername text
}

Table session {
  id text [pk]
  expiresAt timestamp
  token text
  createdAt timestamp
  updatedAt timestamp
  ipAddress text
  userAgent text
  userId text
  impersonatedBy text
  activeOrganizationId text
  activeTeamId text
}

Table account {
  id text [pk]
  accountId text
  providerId text
  userId text
  accessToken text
  refreshToken text
  idToken text
  accessTokenExpiresAt timestamp
  refreshTokenExpiresAt timestamp
  scope text
  password text
  createdAt timestamp
  updatedAt timestamp
}

Table verification {
  id text [pk]
  identifier text
  value text
  expiresAt timestamp
  createdAt timestamp
  updatedAt timestamp
}

Table deviceCode {
  id text [pk]
  deviceCode text
  userCode text
  userId text
  expiresAt timestamp
  status text
  lastPolledAt timestamp
  pollingInterval integer
  clientId text
  scope text
}

Table jwks {
  id text [pk]
  publicKey text
  privateKey text
  createdAt timestamp
  expiresAt timestamp
  alg text
  crv text
}

Table organization {
  id text [pk]
  name text
  slug text
  logo text
  createdAt timestamp
  metadata text
}

Table organizationRole {
  id text [pk]
  organizationId text
  role text
  permission text
  createdAt timestamp
  updatedAt timestamp
}

Table team {
  id text [pk]
  name text
  memberCount integer
  organizationId text
  createdAt timestamp
  updatedAt timestamp
}

Table teamMember {
  id text [pk]
  teamId text
  userId text
  membershipKey text
  createdAt timestamp
}

Table member {
  id text [pk]
  organizationId text
  userId text
  role text
  createdAt timestamp
}

Table invitation {
  id text [pk]
  organizationId text
  email text
  role text
  teamId text
  status text
  expiresAt timestamp
  createdAt timestamp
  inviterId text
}

Table walletAddress {
  id text [pk]
  userId text
  address text
  chainId integer
  isPrimary boolean
  createdAt timestamp
}

Table twoFactor {
  id text [pk]
  secret text
  backupCodes text
  userId text
  verified boolean
  failedVerificationCount integer
  lockedUntil timestamp
}

Ref session_userId_user_id_fk: session.userId > user.id

Ref account_userId_user_id_fk: account.userId > user.id

Ref organizationRole_organizationId_organization_id_fk: organizationRole.organizationId > organization.id

Ref team_organizationId_organization_id_fk: team.organizationId > organization.id

Ref teamMember_teamId_team_id_fk: teamMember.teamId > team.id

Ref teamMember_userId_user_id_fk: teamMember.userId > user.id

Ref member_organizationId_organization_id_fk: member.organizationId > organization.id

Ref member_userId_user_id_fk: member.userId > user.id

Ref invitation_organizationId_organization_id_fk: invitation.organizationId > organization.id

Ref invitation_inviterId_user_id_fk: invitation.inviterId > user.id

Ref walletAddress_userId_user_id_fk: walletAddress.userId > user.id

Ref twoFactor_userId_user_id_fk: twoFactor.userId > user.id