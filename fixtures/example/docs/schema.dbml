Table user {
  id varchar [pk, not null, note: 'Primary key']
  name varchar [not null, note: 'Display name']
}

Table post {
  id varchar [pk, not null, note: 'Primary key']
  title varchar [not null, note: 'Article title']
  content varchar [not null, note: 'Body content (no length limit)']
  user_id varchar [not null, note: 'Foreign key referencing User.id']
}

Ref post_user_id_user_id_fk: post.user_id > user.id